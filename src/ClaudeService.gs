// Claudeが指示を無視して末尾にフック種類・メッセージ方向性のメモ書き
// （例：（数秘術系×転機が来る・流れが変わる））を付けてきた場合に備えた保険的な除去処理。
// 全角/半角どちらの括弧にも対応する。
function stripTrailingHookMemo_(text) {
  return text.replace(/[\s\n]*[（(][^（）()]*×[^（）()]*[）)]\s*$/, '').trim();
}
